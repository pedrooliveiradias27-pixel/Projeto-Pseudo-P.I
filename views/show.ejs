<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Relatórios</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2>Relatórios</h2>
    <table border="1">
        <thead>
            <tr>
                <td>Nome</td>
                <td>Email</td>
                <td>Ação</td>
            </tr>
        </thead>
        <tbody>
            <% crud.forEach(function(details) { %>
                <tr>
                    <td><%= details.nome %></td>
                    <td><%= details.email %></td>
                    <td>
                        <a href="/edit/<%= details._id %>">Alterar</a> - 
                        <a href="/delete/<%= details._id %>">Remover</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <br>
    <a href="/index"><button type="button">Criar Algo Novo</button></a>
</body>
</html>